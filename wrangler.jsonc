{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plush-crypt-pics",
  "main": "worker/r2-storage.js",
  "compatibility_date": "2026-06-20",
  "observability": {
    "enabled": true
  },
  // Public JWKS endpoint used to verify the ES256 session tokens the client
  // sends on uploads/deletes (worker/r2-storage.js). Public info — no secret.
  "vars": {
    "SUPABASE_JWKS_URL": "https://ixymtbrvtysikhuitfta.supabase.co/auth/v1/.well-known/jwks.json"
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "plush-crypt-photos"
    },
    {
      "binding": "CATALOG",
      "bucket_name": "plush-crypt-catalog"
    },
    {
      "binding": "SOCIAL",
      "bucket_name": "plush-crypt-social"
    }
  ]
}
